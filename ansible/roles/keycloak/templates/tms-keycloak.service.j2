[Unit]
Description=TMS Keycloak identity service
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=keycloak
Group=keycloak
WorkingDirectory={{ tms_keycloak_home }}
Environment=JAVA_HOME={{ tms_java_home }}
Environment="JAVA_OPTS_APPEND=-Xms{{ tms_resources.keycloak_heap_initial_mb }}m -Xmx{{ tms_resources.keycloak_heap_max_mb }}m"
EnvironmentFile=/etc/tms/keycloak.env
EnvironmentFile=-/etc/tms/keycloak-bootstrap.env
ExecStart={{ tms_keycloak_home }}/bin/kc.sh start --optimized
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ tms_keycloak_home }}/data

[Install]
WantedBy=multi-user.target
