user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

events { worker_connections 768; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    server_tokens off;

    map $http_upgrade $tms_connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen {{ tms_https_port }} ssl;
        listen [::]:{{ tms_https_port }} ssl;
        server_name {{ tms_hostname }};
        ssl_certificate /etc/tms/tls/server.crt;
        ssl_certificate_key /etc/tms/tls/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        root /srv/tms/current;

        if ($host != {{ tms_hostname }}) { return 444; }
        location = / { return 302 {{ tms_public_origin }}/tms/; }
        location = /tms { return 308 {{ tms_public_origin }}/tms/; }
        location = /tms/index.html { add_header Cache-Control "no-cache"; }
        location /tms/assets/ { try_files $uri =404; }
        location /tms/ { try_files $uri $uri/ /tms/index.html; }
        location = /auth { return 308 {{ tms_public_origin }}/auth/; }
        location = /api { return 308 {{ tms_public_origin }}/api/; }

        # Overwrite forwarded headers at this single public entry point.
        proxy_set_header Host {{ tms_public_origin | urlsplit('netloc') }};
        proxy_set_header X-Forwarded-Host {{ tms_public_origin | urlsplit('netloc') }};
        proxy_set_header X-Forwarded-Port {{ tms_https_port }};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tms_connection_upgrade;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;

        location /auth/ { proxy_pass http://127.0.0.1:8088; }
        location /api/ { proxy_pass http://127.0.0.1:8080/; }
        location / { return 404; }
    }
}
